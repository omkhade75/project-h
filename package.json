{
  "name": "bizora-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/backend",
    "packages/database",
    "packages/ui",
    "packages/types"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:backend": "npm run dev -w services/backend",
    "build:web": "node apps/web/scripts/build.js",
    "build:backend": "npm run build -w services/backend",
    "build": "node apps/web/scripts/build.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3"
  }
}
