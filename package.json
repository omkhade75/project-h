{
  "name": "bizora-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/admin",
    "apps/owner",
    "apps/customer",
    "apps/supplier",
    "services/backend",
    "packages/database",
    "packages/ui",
    "packages/types"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "dev:owner": "npm run dev -w apps/owner",
    "dev:customer": "npm run dev -w apps/customer",
    "dev:supplier": "npm run dev -w apps/supplier",
    "dev:backend": "npm run dev -w services/backend",
    "build:web": "node apps/web/scripts/build.js",
    "build:admin": "node apps/admin/scripts/build.js",
    "build:owner": "node apps/owner/scripts/build.js",
    "build:customer": "node apps/customer/scripts/build.js",
    "build:supplier": "node apps/supplier/scripts/build.js",
    "build:backend": "npm run build -w services/backend",
    "build": "node apps/web/scripts/build.js",
    "build:all": "npm run build -w packages/database && npm run build:admin && npm run build:owner && npm run build:customer && npm run build:supplier && npm run build:backend",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3"
  }
}
