# AI Model Credentials (Configured in Render Environment Dashboard)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Supabase Credentials (Configured in Render Environment Dashboard)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# PostgreSQL Database Connections (Configured in Render Environment Dashboard)
# Transaction-mode pooler for high-throughput queries
DATABASE_URL="postgresql://username:password@your-db-pooler-host:6543/postgres?pgbouncer=true"

# Session-mode direct pooler for Prisma migrations
DIRECT_URL="postgresql://username:password@your-db-direct-host:5432/postgres"

# MongoDB Atlas Connection (Configured in Render Environment Dashboard)
MONGODB_URI="mongodb+srv://username:password@your-cluster.mongodb.net/bizora?retryWrites=true&w=majority"

# JWT Authentication Secret (Configured in Render Environment Dashboard)
JWT_SECRET="your_production_jwt_secret_here"
